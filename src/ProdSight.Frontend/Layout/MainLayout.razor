@inherits LayoutComponentBase
@inject Api.UserProfileService UserProfileService


<header class="my-5">
	<div class="container d-flex justify-content-between">
		<div class="d-flex align-items-center">
			<button class="btn border rounded fs-5" type="button"
			        @onclick="OpenMenuAsync">
				<span class="navbar-toggler-icon"></span>
			</button>
			<span class="ms-4 mb-0 me-2  fs-3">{{ <span style="color: #da27da;">Prod</span>Sight }}</span>
		</div>
		<div class="d-flex align-items-center  fs-5">
			<LoginDisplay />
		</div>
	</div>
</header>

<div class="offcanvas offcanvas-start"
     tabindex="-1" @ref="_offcanvasElement">
	<div class="offcanvas-header">
		<h5 class="offcanvas-title" id="offcanvasMainMenuLabel">{{ <span style="color: #da27da;">Health</span> Report }}</h5>
		<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>
	<div class="offcanvas-body d-flex flex-column">
		<PrimaryMenu NavigateAsync="NavigateAsync" />
	</div>
</div>

<div class="container-fluid mt-5">
	@Body
</div>