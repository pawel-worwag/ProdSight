@page "/health"
@using ProdSight.Api.Shared.DTOs.Health
@using ProdSight.Frontend.Api


@if (HealthStatus != null)
{
    <table class="table table-hover table-borderless my-3">
        <tbody>
        <tr>
            <td class="text-end">Status:</td>
            <td colspan="3"><span class="badge @(HealthStatus.Status=="Healthy"?"bg-success":"bg-danger")">@HealthStatus.Status</span></td>
        </tr>
        <tr>
            <td class="text-end">Last check:</td>
            <td colspan="3">@HealthStatus.LastChecked (UTC)</td>
        </tr>
        </tbody>
    </table>
    <table class="table table-hover mt-5">
        <thead>
        <tr>
            <th>Module/Check</th>
            <th>Status</th>
            <th>Description</th>
            <th>Duration</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var g in HealthStatus.Checks.OrderBy(p=>p.Key))
        {
            <tr>
                <td>@g.Key</td>
                @*
                <td>
                    @if (g.Value.Values.All(p => p.Status == "Healthy"))
                    {
                        <span class="badge bg-success">Healthy</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Unhealthy</span>
                    }
                </td>
                *@
                <td colspan="3"></td>
            </tr>
            
            @foreach (var c in g.Value.OrderBy(p=>p.Key))
            {
                <tr>
                    <td class="ps-5">@c.Key</td>
                    <td><span class="badge @(c.Value.Status == "Healthy" ? "bg-success" : "bg-danger")">@c.Value.Status</span></td>
                    <td>@c.Value.Description</td>
                    <td>@c.Value.Duration</td>
                </tr>
                @if (c.Value.Exception is not null)
                {
                    <tr>
                        <td colspan="2"></td>
                        <td colspan="2">
                            @c.Value.Exception
                        </td>
                    </tr>
                }
            }
        }
        </tbody>
    </table>
}
