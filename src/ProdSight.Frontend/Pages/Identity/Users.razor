@page "/identity/users"
@using Microsoft.AspNetCore.Authorization
@using ProdSight.Frontend.Components.Identity
@attribute [Authorize]

<ClaimRequire ClaimType="identity-module-role" AllowedValues="@(["user", "admin"])" />

<PageTitle>ProdSight - Identity/Users</PageTitle>

<h3>Users</h3>

<table class="table table-hover">
    <thead>
    <tr>
        <th>Username</th>
        <th>First name</th>
        <th>Last name</th>
        <th>Email</th>
        <th>Enabled</th>
        <th>Created</th>
        <th>Totp</th>
    </tr>
    </thead>
    <tbody>
    @if (Data is null || Data.Count == 0)
    {
        <tr><td colspan="7">No data</td></tr>
    }
    else
    {
        @foreach (var u in Data)
        {
            <UserRow User="@u"/>
        }
    }
    </tbody>
</table>