@page "/documents"
@page "/documents/{Id:guid}"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<ClaimRequire ClaimType="documents-module-role" AllowedValues="@(["user", "admin"])"/>

<PageTitle>ProdSight - Documents</PageTitle>

<div class="container">
    <h3 class="mb-3">Documents</h3>
        <table class="table">
            <thead>
            <tr>
                <th colspan="2">Name/Description</th>
                <th>Creation date</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (_items is not null && _items.Count > 0)
            {
                @foreach (var f in _items)
                {
                    <tr>
                        <th scope="row" class="fit clickable" @onclick="() => { OnItemClick(f.IsFolder, f.Id); }">
                            <span class="bi bi-folder-fill"></span>
                        </th>
                        <td class="align-top mono clickable" @onclick="() => { OnItemClick(f.IsFolder, f.Id); }">
                            @f.Name
                            @if (!string.IsNullOrWhiteSpace(f.Description))
                            {
                                <div class="text-muted">@f.Description</div>
                            }
                        </td>
                        <td class="align-top mono clickable" @onclick="() => { OnItemClick(f.IsFolder, f.Id); }">
                            <span class="text-muted ">
                                @f.CreatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </span>
                        </td>
                        <td class="text-end align-top text-muted">
                            <button class="btn btn-sm btn-dark p-0 px-1"><span class="bi bi-three-dots-vertical"></span></button>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
</div>