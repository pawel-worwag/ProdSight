@page "/documents"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<ClaimRequire ClaimType="documents-module-role" AllowedValues="@(["user", "admin"])"/>

<PageTitle>ProdSight - Documents</PageTitle>

<div class="container">
    <h3 class="mb-3">Documents</h3>

    @if (_rootFolders is not null)
    {
        <table class="table">
            <thead>
            <tr>
                <th colspan="2">Name/Description</th>
                <th>Creation date</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var f in _rootFolders)
            {
                <tr>
                    <th scope="row" class="fit"><span class="bi bi-folder-fill"></span></th>
                    <td class="align-top mono">
                        @f.Name
                        @if (!string.IsNullOrWhiteSpace(f.Description))
                        {
                            <div class="text-muted">@f.Description</div>
                        }
                    </td>
                    <td class="align-top mono">
                        <span class="text-muted ">
                            @f.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </span>
                    </td>
                    <td  class="text-end align-top text-muted">
                        <button class="btn btn-sm btn-dark p-0 px-1"><span class="bi bi-three-dots-vertical"></span></button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

</div>