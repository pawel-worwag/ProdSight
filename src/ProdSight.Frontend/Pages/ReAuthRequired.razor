@page "/reauthrequired"
@inject NavigationManager Nav
@inject ILogger<Authentication> Logger

<PageTitle>ProdSight - Token expired</PageTitle>

<div class="container">
    <h3 class="display-5">Token expired</h3>

    <p>Your AccessToken is expired.</p>

    <button @onclick="StartLogin">Sign in</button>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? returnUrl { get; set; }

    public string? url { get; set; }
    
    protected override void OnInitialized()
    {
        url = Uri.EscapeDataString(returnUrl ?? "/");
    }
    
    void StartLogin()
    {
        Nav.NavigateTo($"authentication/login?returnUrl={url}", true);
    }

}
