<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\ProdSight.Api.Modules\IdentityModule\Presentation\ProdSight.Api.Modules.IdentityModule.Presentation.csproj" />
    <ProjectReference Include="..\ProdSight.Api.Modules\MeasurementModule\Presentation\ProdSight.Api.Modules.MeasurementModule.Presentation.csproj" />
    <ProjectReference Include="..\ProdSight.Api.Shared\ProdSight.Api.Shared.csproj" />
    <ProjectReference Include="..\ProdSight.Api.Shared.DTOs\ProdSight.Api.Shared.DTOs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.12.38" />
  </ItemGroup>
  <ItemGroup>
    <_ContentIncludedByDefault Remove="publish\web.config" />
    <_ContentIncludedByDefault Remove="publish\appsettings.json" />
    <_ContentIncludedByDefault Remove="publish\ProdSight.Api.deps.json" />
    <_ContentIncludedByDefault Remove="publish\ProdSight.Api.runtimeconfig.json" />
    <_ContentIncludedByDefault Remove="publish\ProdSight.Api.staticwebassets.endpoints.json" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Target Name="MoveModuleAssembliesToSubfolder" AfterTargets="Publish">
    <PropertyGroup>
      <_ModulesPublishSubfolder>modules</_ModulesPublishSubfolder>
      <_PublishDir>$(PublishDir)</_PublishDir>
    </PropertyGroup>
    <ItemGroup>
      <_ModuleFiles Include="$(_PublishDir)ProdSight.Api.Modules.*.*" />
    </ItemGroup>
    <!-- Create per-module folders under publish/modules -->
    <ItemGroup>
      <_ModuleFolders Include="@(_ModuleFiles->'$(_PublishDir)$(_ModulesPublishSubfolder)/$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)', '^ProdSight\.Api\.Modules\.([^\.]+)\..*$', '$1'))')" />
    </ItemGroup>
    <!-- Remove previous modules folder to avoid leftover files from earlier publishes -->
    <RemoveDir Directories="$(_PublishDir)$(_ModulesPublishSubfolder)" Condition="Exists('$(_PublishDir)$(_ModulesPublishSubfolder)')" />
    <MakeDir Directories="@(_ModuleFolders)" Condition="@(_ModuleFiles) != ''" />
    <!-- Move files into their module folder preserving filename+extension -->
    <Move
      SourceFiles="@(_ModuleFiles)"
      DestinationFiles="@(_ModuleFiles->'$(_PublishDir)$(_ModulesPublishSubfolder)/$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)', '^ProdSight\.Api\.Modules\.([^\.]+)\..*$', '$1'))/%(Filename)%(Extension)')"
      Condition="@(_ModuleFiles) != ''" />
  </Target>
</Project>