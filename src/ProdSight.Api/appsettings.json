{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.IdentityModel": "Debug",
      "ProdSight.Api.Shared.Messaging.DependencyInjection.HandlerRegistration": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Modules": {
    "IdentityModule": {
      "Enabled": true
    },
    "MeasurementModule": {
      "Enabled": true
    },
    "DocumentsModule": {
      "Enabled": true
    }
  },
  "Oidc": {
    "MetadataAddress": "https://keycloak.example.com/realms/TEST1/.well-known/openid-configuration",
    "Authority": "https://keycloak.example.com/auth/realms/TEST1",
    "Audience": "ProdSight.Api"
  },
  "IdentityModule":{
    "Keycloak": {
      "BaseUrl": "https://keycloak.example.com/auth/",
      "Realm": "prod-sight",
      "ClientId": "prod-sight-backend",
      "ClientSecret": "CHANGE_ME_REPLACE_WITH_REAL_SECRET"
    },
    "Database": {
      "ConnectionString":"Host=localhost;Port=5432;Database=prodsight_identity_dev;Username=prodsight;Password=changeme",
      "DatabaseSchema": "identity-module"
    }
  },
  "DocumentsModule": {
    "Database": {
      "ConnectionString": "Host=localhost;Port=5432;Database=prodsight_identity_dev;Username=prodsight;Password=changeme",
      "DatabaseSchema": "documents-module"
    },
    "DiskTemporaryFileStorage": {
      "RootDirectory": "/tmp/prodsight-uploads"
    }
  }
}